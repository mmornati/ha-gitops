{
  "name": "HA GitOps (fork)",
  "version": "0.4.0",
  "slug": "gitops_backup",
  "description": "PR-gated GitHub sync for your Home Assistant config: real-time backup PRs, merged changes applied live, CI validates before merge",
  "url": "https://github.com/mmornati/ha-gitops",
  "arch": [
    "amd64",
    "aarch64",
    "armv7"
  ],
  "init": false,
  "homeassistant_api": true,
  "stdin": true,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:source-branch",
  "panel_title": "GitOps",
  "ports": {
    "8098/tcp": null
  },
  "ports_description": {
    "8098/tcp": "GitHub webhook (POST /webhook); only listens when webhook_secret is set"
  },
  "services": [
    "mqtt:want"
  ],
  "map": [
    "homeassistant_config:rw"
  ],
  "options": {
    "github_repo": "",
    "github_token": "",
    "base_branch": "main",
    "branch_prefix": "auto-backup",
    "interval_hours": 24,
    "run_at_start": false,
    "dry_run": false,
    "commit_name": "HA GitOps Backup",
    "commit_email": "gitops-backup@localhost",
    "signoff": true,
    "apply_after_pull": "auto",
    "auto_restart": false,
    "sync_mode": "both",
    "poll_seconds": 60,
    "debounce_seconds": 120,
    "mqtt_discovery": true
  },
  "schema": {
    "github_repo": "match(^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$)",
    "github_token": "password",
    "base_branch": "str",
    "branch_prefix": "match(^[A-Za-z0-9_/-]+$)",
    "interval_hours": "int(1,168)",
    "run_at_start": "bool",
    "dry_run": "bool",
    "commit_name": "str",
    "commit_email": "str",
    "signoff": "bool",
    "apply_after_pull": "list(auto|reload|restart|off)",
    "auto_restart": "bool",
    "sync_mode": "list(both|pull|push|schedule)",
    "poll_seconds": "int(0,86400)",
    "debounce_seconds": "int(10,3600)",
    "webhook_secret": "password?",
    "mqtt_discovery": "bool"
  }
}
