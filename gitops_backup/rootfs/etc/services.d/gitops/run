#!/usr/bin/with-contenv bashio
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Anil Belur
# ==============================================================================
# HA GitOps — controller (schedule, poll, webhook, file watcher, MQTT, panel).
# The git work itself is done by the engine (python3 -m ha_gitops.engine), which
# the controller runs as a child process, one run at a time.
# ==============================================================================

bashio::log.info "HA GitOps starting"
export BUILD_VERSION
BUILD_VERSION="$(bashio::app.version 2>/dev/null || echo dev)"
cd /app || exit 1
exec python3 -u -m ha_gitops.controller
