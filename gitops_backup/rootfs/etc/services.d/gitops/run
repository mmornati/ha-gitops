# ==============================================================================
# HA GitOps — controller (schedule, poll, webhook, file watcher, MQTT, panel).
# The git work itself is done by /app/gitops_backup.sh, run by the controller.
# ==============================================================================

bashio::log.info "HA GitOps starting"
export BUILD_VERSION
BUILD_VERSION="$(bashio::addon.version 2>/dev/null || echo dev)"
exec python3 -u /app/controller.py
